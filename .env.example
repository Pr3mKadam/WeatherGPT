# ---------------------------------------------------------------------------
# WeatherGPT environment configuration
# Copy this file to ".env" in the project root and fill in what you have.
# The app runs without any key: weather/air/climate APIs are keyless and the
# AI assistant falls back to a clearly-labelled offline insight mode.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas (optional). Leave blank to use the local JSON store.
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/weathergpt
MONGODB_URI=

# Groq (optional). Create a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Supported Groq model. Change it if Groq retires this one.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
GROQ_MAX_TOKENS=900
GROQ_TEMPERATURE=0.4

# Cache TTLs in seconds (optional overrides)
CACHE_TTL_WEATHER=600
CACHE_TTL_AIR=900
CACHE_TTL_CLIMATE=86400
CACHE_TTL_ANALYZER=1800
CACHE_TTL_AI=900

# AI requests allowed per IP per 15 minutes
AI_RATE_LIMIT=40

# CMIP6 model used by the climate projection module
CLIMATE_MODEL=MRI_AGCM3_2_S
